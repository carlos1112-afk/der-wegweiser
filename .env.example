VITE_FIREBASE_PROJECT_ID=der-wegweiser
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_APP_ID=1:430891513864:web:6e7dedec657640a139f9bd
VITE_FIREBASE_AUTH_DOMAIN=der-wegweiser.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=der-wegweiser.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=430891513864
VITE_FIREBASE_MEASUREMENT_ID=G-ZVRKQK2NZ8
VITE_GCP_LOCATION=europe-west3
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_MAPS_API_KEY (Managed via Firebase Secret Manager, do not set plaintext here)
# Set via: firebase functions:secrets:set GOOGLE_MAPS_API_KEY
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Optional: Google Cloud Map Style IDs (Maps Platform → Map Styles in GCloud Console)
# Without these, a built-in fallback style is used automatically
VITE_GOOGLE_MAPS_MAP_ID_TOPO=your_topo_map_id_here
VITE_GOOGLE_MAPS_MAP_ID_CYCLE=your_cycle_map_id_here
VITE_FIREBASE_FUNCTIONS_URL=https://europe-west3-der-wegweiser.cloudfunctions.net
GOOGLE_CLOUD_PROJECT=der-wegweiser
GCP_PROJECT=der-wegweiser

# KI-Anbindung (AiGatewayService). Alle optional; die auskommentierten Zeilen zeigen die Standardwerte.
# VITE_AI_PROVIDER: firebase_ai (Standard) | vertex_callable (Cloud Function aiProxy) | backend_proxy | openai | anthropic | ollama | heuristic_offline
# VITE_AI_PROVIDER=firebase_ai
# Nur firebase_ai: googleai (Standard, Gemini Developer API) | vertex
# VITE_AI_BACKEND=googleai
# VITE_AI_MODEL=gemini-2.0-flash
# VITE_AI_VERTEX_LOCATION=europe-west3

# App Check (optional). Ohne VITE_APPCHECK_SITE_KEY bleibt App Check aus. Der Site-Key ist öffentlich.
# VITE_APPCHECK_SITE_KEY=
# VITE_APPCHECK_PROVIDER: v3 (Standard, reCAPTCHA v3) | enterprise (reCAPTCHA Enterprise)
# VITE_APPCHECK_PROVIDER=v3
# NUR für lokale Entwicklung (npm run dev): festes, in der Firebase-Konsole registriertes Debug-Token.
# NIEMALS in einem Produktions-Build oder in CI setzen: Vite bettet alle VITE_*-Variablen in das
# öffentliche Bundle ein, ein dort lesbares Debug-Token würde App Check aushebeln.
# VITE_APPCHECK_DEBUG_TOKEN=

# Custom API Keys for Map Services
# VITE_THUNDERFOREST_API_KEY=your_thunderforest_api_key_here
# VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
