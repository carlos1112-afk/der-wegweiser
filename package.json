{
  "name": "der-wegweiser",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy_maplibre_worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy_maplibre_worker.mjs",
    "build": "tsc -b && vite build",
    "build:android": "npm run build && npx cap sync android",
    "build:apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:ios": "npm run build && npx cap sync ios",
    "sync": "npx cap sync",
    "test:services": "tsx --test tests/services/**/*.test.ts",
    "test:degradation": "npx tsx --test tests/services.test.mjs",
    "test:scenarios": "node scripts/test_mission_critical_scenarios.mjs",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project demo-wegweiser \"node --test tests/firestore.rules.test.mjs\"",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@google/generative-ai": "^0.24.1",
    "@googlemaps/js-api-loader": "^2.1.3",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.17.0",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.3"
  }
}
