rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Aktiver, nicht gesperrter Nutzer.
    //
    // WICHTIG: Die Prüfung muss UND-verknüpft sein. Die vorherige Fassung
    // enthielt `!isAuthenticated() || !exists(...)` und gab damit anonymen,
    // unauthentifizierten Aufrufen `true` zurück — jeder konnte ohne Konto
    // Ladesäulen, Routen, Bewertungen und Telemetrie anlegen und vorhandene
    // Datensätze überschreiben.
    function isActiveUser() {
      return isAuthenticated()
        && !exists(/databases/$(database)/documents/suspended_users/$(request.auth.uid));
    }

    // Validation for Charging Stations.
    //
    // WICHTIG: Felder sind PFLICHT, nicht nur "validiert falls vorhanden" — eine
    // frühere Fassung prüfte z.B. `!('lat' in data) || (data.lat is number ...)`,
    // das lässt ein Dokument OHNE das Feld komplett durch. Der echte
    // ChargingStation-Typ (src/types/navigation.ts) verlangt name/lat/lng/
    // plugType/createdByUserId ohnehin immer, Weglassen ist also nie ein
    // legitimer Schreibpfad, nur eine Lücke für Angreifer, die diese Felder
    // bewusst auslassen, um die Prüfung zu umgehen.
    function isValidChargingStation() {
      let data = request.resource.data;
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             data.plugType is string && data.plugType in ['schuko_230v', 'bosch', 'bike_energy', 'shimano', 'yamaha', 'unknown'] &&
             data.createdByUserId is string && data.createdByUserId == request.auth.uid;
    }

    // Ersteller-Prüfung. Je nach Schreibpfad wird das Feld `createdByUserId`
    // (Community-Inhalte) oder `userId` (gespeicherte Nutzerdaten) gesetzt,
    // daher werden beide geprüft. `get()` mit Vorgabewert vermeidet
    // Auswertungsfehler bei Dokumenten ohne das jeweilige Feld; die
    // Prüfung fällt in diesem Fall auf "nicht Ersteller" zurück.
    function isCreator() {
      // `resource` ist null, wenn das Dokument nicht existiert (z. B.
      // update/delete eines nie angelegten Dokuments) — dann kann es auch
      // keinen Ersteller geben.
      return resource != null
        && isActiveUser()
        && (
          resource.data.get('createdByUserId', '') == request.auth.uid
          || resource.data.get('userId', '') == request.auth.uid
        );
    }

    // Ersteller-Prüfung bei Neuerstellung von Datensätzen (Schutz vor Authorization Bypass / CWE-862).
    // Stellt sicher, dass das Eigentümerfeld (userId und/oder createdByUserId) zwingend
    // mit request.auth.uid übereinstimmt und widersprüchliche Ownership-Attribute
    // abgewiesen werden.
    function isOwnerOnCreate() {
      let data = request.resource.data;
      let hasUserId = 'userId' in data;
      let hasCreatedBy = 'createdByUserId' in data;
      return isActiveUser()
        && (hasUserId || hasCreatedBy)
        && (!hasUserId || (data.userId is string && data.userId == request.auth.uid))
        && (!hasCreatedBy || (data.createdByUserId is string && data.createdByUserId == request.auth.uid));
    }

    // Verhindert das Ändern der Eigentümerschaft beim Aktualisieren von Datensätzen.
    function isImmutableOwnerOnUpdate() {
      let newData = request.resource.data;
      let oldData = resource.data;
      let hasOldUserId = 'userId' in oldData;
      let hasOldCreatedBy = 'createdByUserId' in oldData;
      return isCreator()
        && (!hasOldUserId || ('userId' in newData && newData.userId == oldData.userId))
        && (!hasOldCreatedBy || ('createdByUserId' in newData && newData.createdByUserId == oldData.createdByUserId));
    }

    // --- 1. User Profiles & Cloud Token States (Art. 17 DSGVO, strikte Isolation) ---
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && !('subscriptionStatus' in request.resource.data);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscriptionStatus']);
    }
    match /user_preferences/{userId} {
      allow read, write, delete: if isOwner(userId);
    }
    match /user_memory_patterns/{userId} {
      allow read, write, delete: if isOwner(userId);
    }
    match /user_tokens/{userId} {
      // Guthaben und Berechtigungs-Token dürfen nicht direkt vom Client erstellt oder geändert werden,
      // um Manipulationen zu verhindern (Backend Admin-SDK veraltet verarbeitet Schreibzugriffe).
      allow read, delete: if isOwner(userId);
      allow create, update: if false;
    }
    match /subscriptions/{userId} {
      allow read, write: if false;
    }

    // --- 2. Charging Stations (Community-Ladeinfrastruktur) ---
    // Lesen: öffentlich (gemeinnützige Infrastruktur, Ladefotos/Preise).
    // Schreiben: nur angemeldete, nicht gesperrte Nutzer.
    // Ändern/Löschen: nur der Ersteller — sonst könnte jeder Nutzer die
    // Ladeinfrastruktur fremder Nutzer überschreiben.
    match /charging_stations/{stationId} {
      allow read: if true;
      allow create: if isActiveUser() && isValidChargingStation();
      allow update: if isCreator() && isValidChargingStation();
      allow delete: if isCreator();
    }
    match /charging_stations_v2/{stationId} {
      allow read: if true;
      allow create: if isActiveUser() && isValidChargingStation();
      allow update: if isCreator() && isValidChargingStation();
      allow delete: if isCreator();
    }

    // --- 3. Points of Interest (kuratierte Radfahrer-Orte) ---
    // Öffentlich lesbar (kein PII, community-nützlich).
    // Anlegen: nur angemeldete Nutzer (Seed-Daten kommen über Admin-SDK).
    // Ändern/Löschen: nur der Ersteller, da createdByUserId null sein kann
    // (Admin-Seed), schützt Community-Einträge vor fremder Überschreibung.
    match /points_of_interest/{poiId} {
      allow read: if true;
      allow create: if isOwnerOnCreate();
      allow update: if isImmutableOwnerOnUpdate();
      allow delete: if isCreator();
    }

    // --- 4. Gespeicherte Routen ---
    // Datenschutz: private Nutzerdaten. Nur der Ersteller darf lesen/schreiben.
    // (`docs/APPLE_UGC_COMPLIANCE.md` weist eigene Routen ausdrücklich als privat aus.)
    match /routes/{routeId} {
      allow read: if isCreator();
      allow create: if isOwnerOnCreate();
      allow update: if isImmutableOwnerOnUpdate();
      allow delete: if isCreator();
    }

    // --- 4. Station Reviews & Ratings ---
    // Öffentlich lesbar, aber nur mit Konto anleg- und änderbar.
    match /station_reviews/{reviewId} {
      allow read: if true;
      allow create: if isOwnerOnCreate();
      allow update: if isImmutableOwnerOnUpdate();
      allow delete: if isCreator();
    }

    // --- 5. Scout Reports ---
    match /scout_reports/{reportId} {
      allow read: if true;
      allow create: if isOwnerOnCreate();
      allow update: if isImmutableOwnerOnUpdate();
      allow delete: if isCreator();
    }

    // --- 6. Collective Spatial Intelligence ---
    // Anonyme Steigungs-/Kurvendaten für die kollektive Kartengrafik.
    // Schreiben nur mit Konto, damit die Sammlung nicht anonym missbraucht
    // werden kann. Die App überträgt ausschließlich quantisierte Koordinaten.
    match /spatial_road_intelligence/{segmentId} {
      allow read: if true;
      allow create, update: if isActiveUser();
      allow delete: if false; // Anonymisierte Datenbankinhalte
    }

    // --- 7. B2B Partner Leads (nur eingehend; Lesen/Löschen für Clients verboten) ---
    match /partner_leads/{leadId} {
      allow create: if isActiveUser();
      allow read, update, delete: if false;
    }

    // --- 8. Content Reports (Apple Guideline 1.2: Moderierung & Meldeweg) ---
    match /content_reports/{reportId} {
      allow create: if isActiveUser();
      // Lesen/Ändern/Löschen bleiben für Clients gesperrt; Einsicht nur über
      // das Admin-SDK, damit Melde-Einträge nicht von Nutzern entfernt werden können.
      allow read, update, delete: if false;
    }

    // --- 9. Gesperrte Nutzer (nur über Security Rules / Admin-SDK) ---
    match /suspended_users/{userId} {
      allow read, write: if false;
    }

    // --- 10. Strikter Default-Fallback: alles Unbehandelte verbieten ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
