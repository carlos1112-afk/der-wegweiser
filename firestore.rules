rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Charging Stations (Community-shared bike infrastructure)
    // Read: public; Create: public; Update: auth users; Delete: strictly forbidden for clients!
    match /charging_stations/{stationId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // 2. Spatial Road Intelligence (Anonymous topography & slope segments)
    // Read & Create: public; Delete: strictly forbidden for clients!
    match /spatial_road_intelligence/{segmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 3. User Preferences & Local Token States
    match /user_preferences/{userId} {
      allow read, write: if true;
    }
    match /user_memory_patterns/{userId} {
      allow read, write: if true;
    }
    match /user_tokens/{userId} {
      allow read, write: if true;
    }

    // 4. Saved Routes & GPX Tracks
    match /routes/{routeId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 5. B2B Partner Leads (Inbound only, read/delete strictly forbidden for public clients)
    match /partner_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // 6. Default Fallback: Read-only, no unauthorized writes or deletions
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
